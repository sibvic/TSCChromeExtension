{
  "manifest_version": 3,
  "name": "Trade Script Converter",
  "version": "0.1.0",
  "description": "Convert the Pine script open on TradingView and download it for MetaTrader, NinjaTrader, or FXTS2.",
  "key": "",
  "permissions": ["storage", "sidePanel", "downloads"],
  "host_permissions": [
    "http://localhost:5120/*",
    "http://127.0.0.1:5120/*",
    "https://localhost:7218/*",
    "http://localhost:5286/*",
    "http://127.0.0.1:5286/*",
    "https://convertor.profitrobots.com/*",
    "https://convertorserver.profitrobots.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5286/*",
      "http://127.0.0.1:5286/*",
      "https://convertor.profitrobots.com/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Trade Script Converter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tradingview.com/*", "https://*.tradingview.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tradingview.com/*", "https://*.tradingview.com/*"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
